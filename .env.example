# Copy this file to .env and fill in real values before running the
# container. These are the exact same values already set as Cloudflare
# Worker secrets for the poultryfit.poultryfit-kenya.workers.dev deployment,
# get them from the same places:

# Supabase project settings -> API
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The disease-prediction ML service, deployed separately on Render.
# This stays on Render regardless of where the web app itself runs;
# JHUB's server does NOT need to also host the ML model.
ML_SERVICE_URL=https://poultryfit-disease-api.onrender.com
ML_SERVICE_API_KEY=

# Google Cloud Console -> Credentials (Places API (New))
GOOGLE_PLACES_API_KEY=